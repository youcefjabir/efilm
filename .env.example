# ======================================================================
# Property Motion Studio — environment configuration
# Copy to .env.local (web) and .env (worker) and fill in what you have.
# The app runs fully in LOCAL mode with zero external accounts.
# ======================================================================

# ---- App identity (change the product name here only) ----
APP_NAME="Property Motion Studio"

# ---- Owner-only access (non-negotiable in launch version) ----
OWNER_ONLY_MODE=true
PUBLIC_SIGNUP_ENABLED=false
BILLING_ENABLED=false
OWNER_EMAIL=youcefjabir8@live.se

# ---- Feature flags (keep off for launch) ----
HYBRID_MOTION_ENABLED=false
GENERATIVE_LIFE_PATCH_ENABLED=false
FIRE_EFFECT_ENABLED=false
CLOUD_EFFECT_ENABLED=false

# ---- Mode selection ----
# AUTH_PROVIDER: "local" (magic link served by the app itself, no external service)
#                or "supabase" (Supabase Auth magic link; requires SUPABASE_* below)
AUTH_PROVIDER=local
# DATABASE_PROVIDER: "pglite" (embedded Postgres, file-backed, zero setup)
#                    or "postgres" (any Postgres/Supabase; requires DATABASE_URL)
DATABASE_PROVIDER=pglite
# STORAGE_PROVIDER: "local" (disk under var/storage, HMAC-signed URLs)
#                   or "supabase" (Supabase Storage private buckets)
STORAGE_PROVIDER=local
# DIRECTOR_PROVIDER: "deterministic" (no API calls; classical vision + heuristics)
#                    or "gemini" (semantic analysis; requires GEMINI_API_KEY)
DIRECTOR_PROVIDER=deterministic
# DEPTH_PROVIDER: "auto" (depth_anything_v2 if model file exists, else geometric)
#                 "depth_anything_v2" | "geometric"
DEPTH_PROVIDER=auto

# ---- Secrets kept server-side only. NEVER prefix with NEXT_PUBLIC_. ----
# Session signing secret for local auth mode (generate: openssl rand -hex 32)
AUTH_SECRET=change-me-generate-a-long-random-value
# Shared secret between web app and render worker (generate: openssl rand -hex 32)
WORKER_SHARED_SECRET=change-me-generate-a-long-random-value
# HMAC secret for signed storage URLs in local storage mode
STORAGE_SIGNING_SECRET=change-me-generate-a-long-random-value

# ---- Local mode paths ----
DATA_DIR=./var/data
STORAGE_DIR=./var/storage

# ---- Web <-> worker ----
# The worker polls the web app for jobs at this base URL.
WEB_INTERNAL_URL=http://localhost:3000
WORKER_CONCURRENCY=1

# ---- Supabase (only when AUTH_PROVIDER/STORAGE_PROVIDER=supabase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- Gemini AI Director (only when DIRECTOR_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ---- Compute provider for the worker ----
# "local" = run services/worker on any CPU machine (default, launch mode)
# "modal" = Modal GPU acceleration (requires MODAL_TOKEN_ID/SECRET)
COMPUTE_PROVIDER=local
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---- Retention ----
# Days to keep rendered artifacts; source images are kept until project deletion.
RENDER_RETENTION_DAYS=90
